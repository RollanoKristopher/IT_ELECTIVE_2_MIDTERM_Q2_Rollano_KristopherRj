<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PlaylistApp</title>

   
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>
        :root {
            --cyan-primary: #00bcd4;
            --cyan-hover: #00acc1;
            --bg-dark: #06171e;
            --card-dark: #0f232a;
            --border-dark: #20414d;
        }

        body {
            background-color: var(--bg-dark);
            color: #e0f7fa;
            font-family: system-ui, -apple-system, sans-serif;
            min-height: 100vh;
        }

        .navbar-custom {
            background-color: var(--card-dark);
            border-bottom: 1px solid var(--border-dark);
        }

        .btn-cyan {
            background-color: var(--cyan-primary);
            color: #041014;
            font-weight: 600;
            border: none;
        }

        .btn-cyan:hover {
            background-color: var(--cyan-hover);
            color: #000;
        }

        .btn-outline-cyan {
            border-color: var(--cyan-primary);
            color: var(--cyan-primary);
        }

        .btn-outline-cyan:hover {
            background-color: var(--cyan-primary);
            color: #041014;
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-sm navbar-custom py-3 shadow-sm">
        <div class="container">
            <a class="navbar-brand fw-bold text-white d-flex align-items-center gap-2" asp-controller="Playlist" asp-action="Index">
                <i class="bi bi-music-note-list fs-4" style="color: var(--cyan-primary);"></i>
                <span>PlaylistApp</span>
            </a>
           <div class="ms-auto">
             <a href="/Auth/Logout" class="btn btn-outline-danger btn-sm rounded-pill px-3">
              <i class="bi bi-box-arrow-right me-1"></i> Logout
            </a>
</div>
        </div>
    </nav>

    <main role="main" class="py-4">
        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>