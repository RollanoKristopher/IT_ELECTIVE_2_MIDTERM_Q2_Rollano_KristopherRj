@model PlaylistApp.Models.DTOs.LoginDto

@{
    Layout = null;
    ViewData["Title"] = "Sign In";
}

<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PlaylistApp</title>

    <!-- Bootstrap 5 CSS CDN -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons CDN -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>
        :root {
            --cyan-primary: #00bcd4;
            --cyan-hover: #00acc1;
            --cyan-glow: rgba(0, 188, 212, 0.25);
            --bg-gradient: linear-gradient(135deg, #06171e 0%, #0d2830 50%, #001219 100%);
            --card-bg: #0f232a;
            --input-bg: #162f38;
            --border-color: #20414d;
        }

        body {
            background: var(--bg-gradient);
            min-height: 100vh;
            color: #e0f7fa;
            font-family: system-ui, -apple-system, sans-serif;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
            padding: 1rem;
        }

        .login-wrapper {
            width: 100%;
            max-width: 420px;
        }

        .login-card {
            background-color: var(--card-bg);
            border: 1px solid var(--border-color) !important;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.6), 0 0 20px rgba(0, 188, 212, 0.08);
            width: 100%;
        }

        .icon-avatar {
            background-color: rgba(0, 188, 212, 0.15);
            color: var(--cyan-primary);
            border: 1px solid rgba(0, 188, 212, 0.3);
        }

        .form-control, .input-group-text {
            background-color: var(--input-bg) !important;
            border-color: var(--border-color) !important;
            color: #e0f7fa !important;
        }

        .form-control:focus {
            border-color: var(--cyan-primary) !important;
            box-shadow: 0 0 0 0.25rem var(--cyan-glow) !important;
        }

        .form-control::placeholder {
            color: #60828c !important;
        }

        .btn-cyan {
            background-color: var(--cyan-primary);
            color: #041014;
            border: none;
            transition: all 0.2s ease-in-out;
        }

        .btn-cyan:hover {
            background-color: var(--cyan-hover);
            color: #000;
            box-shadow: 0 0 15px var(--cyan-glow);
        }

        .hint-box code {
            background-color: #162f38;
            color: var(--cyan-primary);
            padding: 0.15rem 0.4rem;
            border-radius: 4px;
            border: 1px solid var(--border-color);
        }

        /* FIX: Absolutely hide validation summary when valid/empty */
        .validation-summary-valid {
            display: none !important;
        }

        /* Style validation box ONLY when active with errors */
        .validation-summary-errors {
            background-color: rgba(220, 53, 69, 0.15) !important;
            border: 1px solid rgba(220, 53, 69, 0.3) !important;
            color: #ff8585 !important;
            padding: 0.5rem 0.75rem;
            border-radius: 0.5rem;
            margin-bottom: 1rem;
            font-size: 0.875rem;
        }

        .validation-summary-errors ul {
            margin-bottom: 0;
            padding-left: 1.25rem;
        }
    </style>
</head>
<body>

    <div class="login-wrapper">
        <div class="card login-card rounded-4">
            <div class="card-body p-4 p-sm-5">
                
                <!-- Header -->
                <div class="text-center mb-4">
                    <div class="icon-avatar rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px;">
                        <i class="bi bi-person-fill fs-2"></i>
                    </div>
                    <h2 class="fw-bold text-white mb-1 fs-3">Welcome Back</h2>
                    <p class="small mb-0" style="color: #8daab3;">Please sign in to your account</p>
                </div>

                <!-- Validation Summary (No alert classes = No invisible empty box) -->
                <div asp-validation-summary="ModelOnly"></div>

                <!-- Form -->
                <form action="/Auth/Login" method="post">
                    <div class="mb-3">
                        <label for="Username" class="form-label fw-semibold small text-light opacity-75">Username</label>
                        <div class="input-group">
                            <span class="input-group-text border-end-0">
                                <i class="bi bi-person" style="color: #00bcd4;"></i>
                            </span>
                            <input type="text" id="Username" name="Username" value="@Model?.Username" class="form-control border-start-0 ps-0" placeholder="Enter username" autocomplete="username" required />
                        </div>
                        <span asp-validation-for="Username" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-4">
                        <label for="Password" class="form-label fw-semibold small text-light opacity-75">Password</label>
                        <div class="input-group">
                            <span class="input-group-text border-end-0">
                                <i class="bi bi-lock" style="color: #00bcd4;"></i>
                            </span>
                            <input type="password" id="Password" name="Password" class="form-control border-start-0 ps-0" placeholder="Enter password" autocomplete="current-password" required />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <button type="submit" class="btn btn-cyan w-100 py-2.5 fw-bold rounded-3 shadow-sm mb-3">
                        Sign In
                    </button>
                </form>

                <!-- Hint Footer -->
                <div class="text-center pt-3 border-top border-secondary border-opacity-25 mt-3 hint-box">
                    <p class="small mb-0" style="color: #8daab3;">
                        <i class="bi bi-info-circle me-1" style="color: #00bcd4;"></i>
                        <strong>Hint:</strong> <code>admin</code> / <code>password123</code>
                    </p>
                </div>

            </div>
        </div>
    </div>

</body>
</html>