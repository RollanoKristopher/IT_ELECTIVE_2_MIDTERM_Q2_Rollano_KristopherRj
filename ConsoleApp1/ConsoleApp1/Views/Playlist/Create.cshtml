@model PlaylistApp.Models.DTOs.CreatePlaylistDto

@{
    ViewData["Title"] = "Create Playlist";
}

<style>
    :root {
        --cyan-primary: #00bcd4;
        --cyan-hover: #00acc1;
        --cyan-glow: rgba(0, 188, 212, 0.25);
        --card-bg: #0f232a;
        --input-bg: #162f38;
        --border-color: #20414d;
    }

    .form-card {
        background-color: var(--card-bg);
        border: 1px solid var(--border-color) !important;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.6), 0 0 20px rgba(0, 188, 212, 0.08);
    }

    .card-header-cyan {
        background-color: #122830;
        border-bottom: 1px solid var(--border-color);
    }

    .form-control, .input-group-text {
        background-color: var(--input-bg) !important;
        border-color: var(--border-color) !important;
        color: #e0f7fa !important;
    }

    .form-control:focus {
        border-color: var(--cyan-primary) !important;
        box-shadow: 0 0 0 0.25rem var(--cyan-glow) !important;
    }

    .form-control::placeholder {
        color: #60828c !important;
    }

    .btn-cyan {
        background-color: var(--cyan-primary);
        color: #041014;
        border: none;
        transition: all 0.2s ease-in-out;
    }

    .btn-cyan:hover {
        background-color: var(--cyan-hover);
        color: #000;
        box-shadow: 0 0 15px var(--cyan-glow);
    }

    .btn-outline-cyan {
        border: 1px dashed var(--cyan-primary);
        color: var(--cyan-primary);
        background-color: rgba(0, 188, 212, 0.05);
    }

    .btn-outline-cyan:hover {
        background-color: rgba(0, 188, 212, 0.15);
        color: #fff;
        border-color: var(--cyan-primary);
    }


    .validation-summary-valid {
        display: none !important;
    }

    .validation-summary-errors {
        background-color: rgba(220, 53, 69, 0.15) !important;
        border: 1px solid rgba(220, 53, 69, 0.3) !important;
        color: #ff8585 !important;
        padding: 0.5rem 0.75rem;
        border-radius: 0.5rem;
        margin-bottom: 1rem;
        font-size: 0.875rem;
    }

    .validation-summary-errors ul {
        margin-bottom: 0;
        padding-left: 1.25rem;
    }
</style>

<div class="container my-5" style="max-width: 680px;">
    <!-- Back Button / Top Navigation -->
    <div class="mb-3">
        <a asp-action="Index" class="text-decoration-none small d-inline-flex align-items-center gap-1" style="color: #8daab3;">
            <i class="bi bi-arrow-left"></i> Back to Playlists
        </a>
    </div>

    <!-- Main Card -->
    <div class="card form-card rounded-4 overflow-hidden">
        <!-- Header -->
        <div class="card-header-cyan text-white p-4">
            <div class="d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px; background-color: rgba(0, 188, 212, 0.15); color: #00bcd4; border: 1px solid rgba(0, 188, 212, 0.3);">
                        <i class="bi bi-music-note-list fs-4"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold mb-0 text-white">Create New Playlist</h4>
                        <p class="mb-0 small" style="color: #8daab3;">Add a title and YouTube tracks to your collection</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card Body -->
        <div class="card-body p-4 p-md-5">
            <form method="post">
                <!-- Clean Validation Summary -->
                <div asp-validation-summary="ModelOnly"></div>

                <!-- Playlist Title -->
                <div class="mb-4">
                    <label asp-for="Title" class="form-label fw-semibold small text-light opacity-75">Playlist Title</label>
                    <div class="input-group">
                        <span class="input-group-text border-end-0">
                            <i class="bi bi-type-h1" style="color: #00bcd4;"></i>
                        </span>
                        <input asp-for="Title" class="form-control border-start-0 ps-0" placeholder="e.g. OPM Chill Hits" />
                    </div>
                    <span asp-validation-for="Title" class="text-danger small mt-1 d-block"></span>
                </div>

                <!-- Track List Section Header -->
                <div class="d-flex align-items-center justify-content-between mt-4 mb-3">
                    <h6 class="fw-bold text-white mb-0">
                        <i class="bi bi-collection-play me-2" style="color: #00bcd4;"></i>Track List
                    </h6>
                    <span class="badge rounded-pill fw-normal px-3 py-2" style="background-color: #162f38; color: #00bcd4; border: 1px solid #20414d;">
                        @(Model?.Videos?.Count ?? 0) Tracks
                    </span>
                </div>

                <!-- Video Rows -->
                <div class="d-flex flex-column gap-3 mb-4">
                    @if (Model?.Videos != null)
                    {
                        @for (int i = 0; i < Model.Videos.Count; i++)
                        {
                            <div class="card border-0 rounded-3 p-3" style="background-color: #122830; border: 1px solid #1a3843 !important;">
                                <div class="d-flex align-items-center justify-content-between mb-3">
                                    <span class="badge rounded-2 px-2 py-1" style="background-color: #162f38; color: #8daab3; border: 1px solid #20414d;">
                                        <i class="bi bi-hash me-1" style="color: #00bcd4;"></i>Track @(i + 1)
                                    </span>
                                    @if (Model.Videos.Count > 1)
                                    {
                                        <button type="submit"
                                                asp-action="RemoveVideoRow"
                                                asp-route-index="@i"
                                                formnovalidate
                                                class="btn btn-link text-danger text-decoration-none p-0 fs-7 d-inline-flex align-items-center gap-1">
                                            <i class="bi bi-trash"></i> Remove
                                        </button>
                                    }
                                </div>

                                <div class="row g-2">
                                    <div class="col-12">
                                        <div class="input-group input-group-sm">
                                            <span class="input-group-text border-end-0 text-danger">
                                                <i class="bi bi-youtube"></i>
                                            </span>
                                            <input name="Videos[@i].YouTubeUrl"
                                                   value="@Model.Videos[i].YouTubeUrl"
                                                   class="form-control border-start-0 ps-0"
                                                   placeholder="https://www.youtube.com/watch?v=..." />
                                        </div>
                                    </div>
                                    <div class="col-12">
                                        <div class="input-group input-group-sm">
                                            <span class="input-group-text border-end-0">
                                                <i class="bi bi-chat-left-text" style="color: #00bcd4;"></i>
                                            </span>
                                            <input name="Videos[@i].TrackNote"
                                                   value="@Model.Videos[i].TrackNote"
                                                   class="form-control border-start-0 ps-0"
                                                   placeholder="Track Note (e.g. Favorite acoustic version)" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>

                <!-- Add Track Button -->
                <div class="mb-4">
                    <button type="submit" 
                            asp-action="AddVideoRow" 
                            formnovalidate 
                            class="btn btn-outline-cyan w-100 py-2 rounded-3 fw-semibold d-flex align-items-center justify-content-center gap-2">
                        <i class="bi bi-plus-circle"></i> Add Another Track
                    </button>
                </div>

                <hr class="border-secondary border-opacity-25 my-4" />

                <!-- Action Buttons -->
                <div class="d-flex gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary w-33 py-2.5 rounded-3 fw-semibold border-opacity-50 text-light">Cancel</a>
                    <button type="submit" asp-action="Save" class="btn btn-cyan flex-grow-1 py-2.5 rounded-3 fw-bold shadow-sm d-flex align-items-center justify-content-center gap-2">
                        <i class="bi bi-check-circle-fill"></i> Save Complete Playlist
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>