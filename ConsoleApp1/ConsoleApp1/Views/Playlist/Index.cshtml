@model List<PlaylistApp.Models.Entities.Playlist>

@{
    ViewData["Title"] = "Playlists";
}

<div class="container my-4" style="max-width: 800px;">
    
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-white mb-1">Playlists</h2>
            <p class="small mb-0" style="color: #8daab3;">Browse and discover curated video collections</p>
        </div>
        <div class="d-flex align-items-center gap-2">
        
          <a href="/Playlist/Create" class="btn btn-cyan rounded-pill px-4 py-2 shadow-sm d-inline-flex align-items-center gap-2">
    <i class="bi bi-plus-lg"></i> Create
</a>

            <a href="/Auth/Logout" class="btn btn-outline-danger btn-sm rounded-pill px-3">
              <i class="bi bi-box-arrow-right me-1"></i> Logout
            </a>
        </div>
    </div>

    <hr class="border-secondary border-opacity-25 mb-4" />

    
    @if (Model != null && Model.Any())
    {
        <div class="d-flex flex-column gap-3">
            @foreach (var item in Model)
            {
                <div class="card rounded-4 p-2" style="background-color: #0f232a; border: 1px solid #20414d;">
                    <div class="card-body">
                        <!-- Header -->
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <div class="d-flex align-items-center gap-3">
                                <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px; background-color: rgba(0, 188, 212, 0.15); color: #00bcd4; border: 1px solid rgba(0, 188, 212, 0.3);">
                                    <i class="bi bi-collection-play-fill fs-4"></i>
                                </div>
                                <div>
                                    <h4 class="fw-bold mb-0 text-white">@item.Title</h4>
                                    <span class="small" style="color: #8daab3;">
                                        <i class="bi bi-person-circle me-1"></i>Created by <strong class="text-white">@item.CreatorName</strong>
                                    </span>
                                </div>
                            </div>
                            <span class="badge rounded-pill fw-normal px-3 py-2" style="background-color: #162f38; color: #00bcd4; border: 1px solid #20414d;">
                                <i class="bi bi-film me-1"></i>@(item.Videos?.Count ?? 0) Tracks
                            </span>
                        </div>

                        <!-- Track list -->
                        @if (item.Videos != null && item.Videos.Any())
                        {
                            <div class="rounded-3 p-3 mt-3" style="background-color: #122830; border: 1px solid #1a3843;">
                                <ul class="list-group list-group-flush bg-transparent">
                                    @foreach (var video in item.Videos)
                                    {
                                        <li class="list-group-item bg-transparent border-0 px-0 py-2 d-flex align-items-center justify-content-between gap-2">
                                            <div class="d-flex align-items-center gap-2 overflow-hidden">
                                                <i class="bi bi-youtube text-danger fs-5 flex-shrink-0"></i>
                                                <a href="@video.YouTubeUrl" target="_blank" rel="noopener noreferrer" class="text-decoration-none text-truncate fw-medium" style="color: #00bcd4;">
                                                    @video.YouTubeUrl
                                                </a>
                                            </div>
                                            @if (!string.IsNullOrEmpty(video.TrackNote))
                                            {
                                                <span class="badge rounded-2 fw-normal flex-shrink-0" style="background-color: #162f38; color: #8daab3; border: 1px solid #20414d;">
                                                    <i class="bi bi-chat-left-text me-1"></i>@video.TrackNote
                                                </span>
                                            }
                                        </li>
                                    }
                                </ul>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="bi bi-music-note-beats fs-1" style="color: #00bcd4;"></i>
            <p class="mt-2 text-secondary">No playlists found. Create one to get started!</p>
        </div>
    }
</div>